\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Resultados de la validación cruzada, listados por RMSE. The generalization gap is the mean test RMSE minus the mean train RMSE.}}{9}{table.3}\protected@file@percent }
