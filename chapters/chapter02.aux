\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Final train RMSE per fold for each number of factors $k$ ($\lambda = 0.01$). The initial train RMSE was approximately 3.653 in every fold.}}{10}{table.5}\protected@file@percent }
